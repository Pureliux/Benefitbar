<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"
	FileETag None
	Header always unset ETag

	# Do not cache app routes or index.html. Otherwise users can keep seeing an old React bundle.
	Header always set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
	Header always set Pragma "no-cache"
	Header always set Expires "0"

	# Force browsers to drop stale cached app shells when opening routes such as /login.
	<If "%{REQUEST_URI} !~ m#^/assets/# && %{REQUEST_URI} !~ m#^/api/#">
		Header always set Clear-Site-Data "\"cache\""
	</If>

	# Hashed Vite assets are safe to cache for a long time.
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header always set Cache-Control "public, max-age=31536000, immutable"
		Header always unset Pragma
		Header always unset Expires
		Header always unset Clear-Site-Data
	</If>
</IfModule>
